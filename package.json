{
  "name": "@dockploy/local-agent",
  "version": "0.5.1",
  "private": true,
  "description": "Conector local para túneles remotos de Dockploy",
  "type": "module",
  "bin": {
    "dockploy-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node --eval \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
